@startuml
!define OMIT_PARTICIPANT_PADDING
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
left to right direction

Package Model as ModelPackage <<Rectangle>> {
    Class "<<interface>>\nModel" as Model
    Class ModelManager
    Class AddressBook
    Class UserPrefs
    Class Menu
    Class FoodItem
    Class MilestoneCatalog
    Class Milestone
    Class Person
}

ModelManager .up.|> Model

ModelManager "1" *--> "1" AddressBook : owns
ModelManager "1" *--> "1" UserPrefs : owns
ModelManager "1" *--> "1" Menu : owns
ModelManager "1" *--> "1" MilestoneCatalog : owns

AddressBook "1" *--> "0..*" Person : contains
Menu "1" *--> "0..*" FoodItem : contains
MilestoneCatalog "1" *--> "0..*" Milestone : contains

note right of Person
  Includes contact details, score,
  tags, order history, and redeemed
  milestone rewards.
end note

note bottom of Model
  Provides access to the model data
  through a read-only public API.
end note
@enduml
