@startuml
!define OMIT_PARTICIPANT_PADDING
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
left to right direction

Package Model as ModelPackage <<Rectangle>> {
    Class "<<interface>>\nModel" as Model
    Class ModelManager
    Class AddressBook
    Class UserPrefs
    Class Menu
    Class FoodItem
    Class MilestoneCatalog
    Class Milestone
    Class Person
}

ModelManager .up.|> Model

ModelManager "1" *--> "1" AddressBook : owns
ModelManager "1" *--> "1" UserPrefs : owns
ModelManager "1" *--> "1" Menu : owns
ModelManager "1" *--> "1" MilestoneCatalog : owns

AddressBook "1" *--> "0..*" Person : contains
Menu "1" *--> "0..*" FoodItem : contains
MilestoneCatalog "1" *--> "0..*" Milestone : contains

note "Includes contact details, score,\ntags, order history, and redeemed\nmilestone rewards." as PersonNote
Person -[hidden]down- PersonNote
Person -[dotted]- PersonNote

note "Provides access to the model data\nthrough a read-only public API." as ModelNote
Model -[dotted]- ModelNote
@enduml
