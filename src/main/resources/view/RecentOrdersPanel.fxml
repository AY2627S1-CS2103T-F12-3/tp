<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="profile-orders" minWidth="0" maxHeight="Infinity">
  <Label text="Recent Orders" styleClass="profile-orders-title" maxWidth="Infinity" />
  <HBox styleClass="profile-order-header">
    <Label text="#" styleClass="profile-order-index" />
    <Label text="Order" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
    <Label text="Qty" styleClass="profile-order-quantity" />
  </HBox>
  <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
              styleClass="profile-order-scroll">
    <VBox fx:id="orders" />
  </ScrollPane>
</VBox>
